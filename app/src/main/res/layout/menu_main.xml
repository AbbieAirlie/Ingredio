<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".menuMain">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_first"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ingredio_green"
            android:padding="20dp"
            android:text="@string/cupboard"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_cupboard"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_second"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ingredio_green"
            android:padding="20dp"
            android:text="@string/recipes"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_browse"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_first" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_shopping_list"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ingredio_green"
            android:padding="20dp"
            android:text="@string/shopping_list_button"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_shopping_list"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_second" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_saved_recipes"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ingredio_green"
            android:padding="20dp"
            android:text="@string/saved_recipes_title"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_saved"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_shopping_list" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_meal_planner"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/ingredio_green"
            android:padding="20dp"
            android:text="@string/meal_planner_title"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_calendar"
            app:iconPadding="12dp"
            app:iconSize="28dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_saved_recipes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>